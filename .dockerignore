# 가상환경 및 Git 메타데이터 제외
venv/
.venv/
.git/
.gitignore
.vscode/
.idea/

# Python 바이트코드 캐시 및 프로파일링 덤프 제외
**/__pycache__/
*.py[cod]
*$py.class
*.prof

# 로컬에서 생성된 테스트 결과 오디오 제외 (reference_audios/는 유지)
/*.wav

# 모델 가중치는 Docker 빌드 중 download.py를 통해 다운로드하므로 로컬 파일 복사 제외
GPT_weights_v2/*.onnx
GPT_weights_v2/*.ckpt
GPT_weights_v2/*.safetensors
SoVITS_weights_v2/*.onnx
SoVITS_weights_v2/*.pth
GPT_SoVITS/pretrained_models/**/*.safetensors
GPT_SoVITS/pretrained_models/**/*.bin
GPT_SoVITS/pretrained_models/**/*.pth
GPT_SoVITS/pretrained_models/**/*.ckpt

